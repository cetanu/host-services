[Unit]
Description=Envoy edge proxy with ACME dynamic module
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=envoy
Group=envoy
ExecStart=/usr/local/bin/envoy --config-path /etc/envoy/envoy.yaml --log-level info
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/envoy-acme
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=ENVOY_DYNAMIC_MODULES_SEARCH_PATH=/usr/local/lib/envoy/modules

[Install]
WantedBy=multi-user.target

